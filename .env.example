# Kaksha Environment Variables Configuration (.env)

# 1. Supabase Authentication Credentials
# Get these from: Supabase Console (https://supabase.com/dashboard) -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 2. Production URL Configuration (Optional for local testing)
VITE_APP_URL=http://localhost:5173
